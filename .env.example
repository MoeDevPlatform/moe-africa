# API base URL — defaults to https://moe-backend.duckdns.org for local dev
# Switch to production when deploying:
#   VITE_API_BASE_URL=https://api.moe-africa.com
VITE_API_BASE_URL=https://moe-backend.duckdns.org

# Clerk (publishable key only — never the secret key). Clerk app: app_3KBVAlbswmiY6AGLwqAZrof82aM
# Leave empty to run on the legacy email/password auth flow.
VITE_CLERK_PUBLISHABLE_KEY=

# Admin portal credentials for Playwright seed approval (local .env only — never commit)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Pexels (server-side scripts only — never prefix with VITE_)
PEXELS_API_KEY=
